# ==========================================
# VaultRAG - Environment Variables Template
# Copy this file to .env: `cp .env.example .env`
# ==========================================

# ------------------------------------------
# Django Application Settings
# ------------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-vaultrag-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------
# PostgreSQL Database & pgvector
# ------------------------------------------
POSTGRES_DB=vaultrag_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Container Admin Superuser (Used ONLY for container init and extension creation)
POSTGRES_ADMIN_USER=vaultrag_admin
POSTGRES_ADMIN_PASSWORD=vaultrag_admin_password_dev

# Application Runtime Login (Non-superuser with NOBYPASSRLS for strict RLS enforcement)
POSTGRES_APP_USER=vaultrag_user
POSTGRES_APP_PASSWORD=vaultrag_secure_password_dev

# ------------------------------------------
# Multi-Tenancy & Registration Security
# ------------------------------------------
# Set to False by default; set to True in development or supply an invitation code
# Registration modes:
#   ALLOW_PUBLIC=True  + REQUIRES_APPROVAL=True   -> anyone can REQUEST access; you approve in Django admin (recommended)
#   ALLOW_PUBLIC=True  + REQUIRES_APPROVAL=False  -> open self-service signup
#   ALLOW_PUBLIC=False                            -> invite code only
# A valid TENANT_REGISTRATION_INVITE_CODE always skips the approval queue.
ALLOW_PUBLIC_TENANT_REGISTRATION=True
TENANT_REGISTRATION_REQUIRES_APPROVAL=True
TENANT_REGISTRATION_MAX_PENDING=50
TENANT_REGISTRATION_INVITE_CODE=
FRONTEND_BASE_URL=http://localhost:3000

# Dedicated JWT signing key (defaults to DJANGO_SECRET_KEY if empty)
JWT_SIGNING_KEY=

# ------------------------------------------
# Redis & Celery
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------
# MinIO / Object Storage (S3 Compatible)
# ------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=vaultrag-documents
MINIO_USE_SSL=False

# ------------------------------------------
# Email & Inbound Lead Notifications (SMTP / Resend / SES)
# ------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=VaultRAG Notifications <leads@vaultrag.com>
ADMIN_EMAILS=

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
PORT=3000

# ------------------------------------------
# AI Provider / LLM & Embeddings (NVIDIA NIM)
# ------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
VLM_MODEL=meta/llama-3.2-11b-vision-instruct
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
OPENAI_API_KEY=your_openai_api_key_here
