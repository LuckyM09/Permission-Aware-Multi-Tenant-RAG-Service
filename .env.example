# ==========================================
# VaultRAG - Environment Variables Template
# Copy this file to .env: `cp .env.example .env`
# ==========================================

# ------------------------------------------
# Django Application Settings
# ------------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-vaultrag-key-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------
# PostgreSQL Database & pgvector
# ------------------------------------------
POSTGRES_DB=vaultrag_db
POSTGRES_USER=vaultrag_app
POSTGRES_PASSWORD=vaultrag_secure_password_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ------------------------------------------
# Redis & Celery
# ------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ------------------------------------------
# MinIO / Object Storage (S3 Compatible)
# ------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=vaultrag-documents
MINIO_USE_SSL=False

# ------------------------------------------
# Frontend (Next.js)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
PORT=3000

# ------------------------------------------
# AI Provider / LLM & Embeddings (NVIDIA NIM)
# ------------------------------------------
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
